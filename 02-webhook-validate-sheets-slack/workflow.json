        "text": "=:bar_chart: *Daily order digest — {{ $json.date }}*\n• Events received: *{{ $json.count }}*\n• Paid total: *{{ $json.paidTotal }}*\n• By source: {{ $json.bySource }}\n• By status: {{ $json.byStatus }}",
        "otherOptions": {}
      },
