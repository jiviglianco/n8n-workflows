      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2000000-0000-4000-8000-000000000002",
              "leftValue": "={{ String($json.received_at || '') }}",
              "rightValue": "={{ $now.minus({ days: 1 }).toFormat('yyyy-LL-dd') }}",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000012",
      "name": "Yesterday Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [520, 720],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Aggregate yesterday's rows into a single summary item.\n// \"Yesterday Only\" has Always Output Data on, so on an empty day we receive one empty item.\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.event_id);\n\nconst bySource = {};\nconst byStatus = {};\nlet total = 0;\nfor (const r of rows) {\n  bySource[r.source] = (bySource[r.source] || 0) + 1;\n  byStatus[r.status] = (byStatus[r.status] || 0) + 1;\n  const amt = Number(r.amount);\n  if (!Number.isNaN(amt) && r.status === 'paid') total += amt;\n}\n\nconst fmt = (obj) => Object.entries(obj).map(([k, v]) => `${k}: ${v}`).join(', ') || 'none';\nconst date = $now.minus({ days: 1 }).toFormat('yyyy-LL-dd');\n\nreturn [{\n  json: {\n    date,\n    count: rows.length,\n    paidTotal: Math.round(total * 100) / 100,\n    bySource: fmt(bySource),\n    byStatus: fmt(byStatus),\n  },\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000013",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 720]
    },
